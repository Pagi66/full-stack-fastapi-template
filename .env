# ==============================================================================
# FLEET ERP - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file contains environment variables for the Fleet ERP application.
# For production deployment, ensure all CHANGEME values are properly set.
# ==============================================================================

# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application environment: local, staging, production
ENVIRONMENT=local

# Project metadata
PROJECT_NAME="Apex"
STACK_NAME=apex

# Domain configuration for production
DOMAIN=localhost

# ==============================================================================
# JWT AUTHENTICATION & SECURITY
# ==============================================================================

# Secret key for JWT token signing (64-byte secure random)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=FQa0qlYzbXwo8QAhOQFq6VxVxnftdu5_9a7tOB2B4_up8GXLL7X9DsJiWnLBpeewVb80JXUfSOg3WvwbUDHCZg

# Secret key for refresh token signing (64-byte secure random)
REFRESH_SECRET=ZsZRB5uKwOHCb4X2Zla5HVKAVFa2ZPVL21YnE6w0vaWHzD81FsGNAFcNR6He6WxEKi97pSnU9W-fdeOi1YR7rg

# Token expiration settings (production values)
ACCESS_TOKEN_EXPIRE_MINUTES=15          # Short-lived access tokens for security
REFRESH_TOKEN_EXPIRE_DAYS=7             # Longer-lived refresh tokens
EMAIL_RESET_TOKEN_EXPIRE_HOURS=1        # Password reset token expiration

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================


# Individual database settings (alternative to DATABASE_URL)
POSTGRES_SERVER=db 
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Konohamaru10

# ==============================================================================
# FRONTEND & CORS CONFIGURATION
# ==============================================================================

# Production frontend URL (used for email links and CORS)
FRONTEND_HOST=https://localhost:5173

# CORS origins for production (comma-separated list)
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"

# OAuth2 callback URLs for production
OAUTH_REDIRECT_URI=https://your-frontend-domain.com/auth/callback
OAUTH_GOOGLE_REDIRECT_URI=https://your-frontend-domain.com/auth/google/callback
OAUTH_GITHUB_REDIRECT_URI=https://your-frontend-domain.com/auth/github/callback

# ==============================================================================
# OAUTH2 PROVIDER CONFIGURATION
# ==============================================================================

# Google OAuth2 Configuration
# Register at: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=CHANGEME_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=CHANGEME_google_oauth_client_secret
GOOGLE_OAUTH_SCOPES="openid email profile"

# GitHub OAuth2 Configuration  
# Register at: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=CHANGEME_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=CHANGEME_github_oauth_client_secret
GITHUB_OAUTH_SCOPES="user:email"

# ==============================================================================
# EMAIL SERVICE CONFIGURATION
# ==============================================================================

# Production SMTP server configuration
SMTP_HOST=smtp.mailersend.net              # Or your production SMTP provider
SMTP_PORT=587                           # TLS port (use 465 for SSL)
SMTP_USER=MS_GGGgzH@test-pzkmgq769qyl059v.mlsender.net
SMTP_PASSWORD=mssp.ys7tRi6.3vz9dlek186lkj50.sDmJA8U
SMTP_TLS=True
SMTP_SSL=False

# Email sender configuration
EMAILS_FROM_EMAIL=illmindofbennyj@gmail.com
EMAILS_FROM_NAME=illmindofbennyj@gmail.com

# ==============================================================================
# MONITORING & ANALYTICS
# ==============================================================================

# Sentry DSN for error tracking (production)
SENTRY_DSN=https://CHANGEME@sentry.io/CHANGEME

# ==============================================================================
# ADMINISTRATIVE SETTINGS
# ==============================================================================

# First superuser account (created on initial setup)
FIRST_SUPERUSER=illmindofbennyj@gmail.com
FIRST_SUPERUSER_PASSWORD=Konohamaru10

# ==============================================================================
# DOCKER & DEPLOYMENT
# ==============================================================================

# Docker image names for production
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# ==============================================================================
# LOCAL DEVELOPMENT OVERRIDES (IGNORED IN PRODUCTION)
# ==============================================================================
# The following section is for local development only
# Production should use the values above
